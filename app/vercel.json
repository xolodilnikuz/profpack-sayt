{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/((?!static/|assets/|ru/?$|en/?$|karobka/?$|pechat/?$|gofrokarton/?$|rulon-qogoz/?$|makulatura/?$|ru/korobki/?$|ru/pechat/?$|ru/gofrokarton/?$|ru/bumaga/?$|ru/makulatura/?$|en/boxes/?$|en/printing/?$|en/corrugated-board/?$|en/paper-rolls/?$|en/waste-paper/?$)[^.]+)",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
